# Application Settings
PROJECT_NAME="Codex Vitae SaaS"
SECRET_KEY="super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 days

# Database Settings (PostgreSQL or SQLite fallback)
# For production PostgreSQL (Supabase/Neon/Render): postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/codex_vitae?sslmode=require
DATABASE_URL="sqlite:///./codex_vitae.db"

# LLM Integration Settings (LiteLLM with Groq / OpenRouter / OpenAI)
# Leave empty to use Mock LLM mode in development/testing
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
DEFAULT_LLM_MODEL="groq/llama-3.3-70b-versatile"

# Stripe Monetization Settings
# Leave empty to use Mock Checkout mode in development
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO="price_1234567890_pro"
DOMAIN_URL="http://localhost:8000"
