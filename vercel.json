{
  "devCommand": "uvicorn app.main:app --reload",
  "buildCommand": "pip install -r requirements.txt",
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/sw.js",
      "dest": "/app/static/sw.js"
    },
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ]
}
